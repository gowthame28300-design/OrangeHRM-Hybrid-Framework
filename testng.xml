<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM Suite"
       parallel="tests"
       thread-count="2">

<listeners>
    <listener class-name="listeners.ListenerClass"/>
</listeners>


   
    
    
    <test name="Chrome Test">
    
     <parameter name="browser" value="chrome"/>

        <classes>
          
            <class name="testCases.TC001_LoginTest"/>
            <class name="testCases.TC002_AddEmployeeTest"/>
             <class name="testCases.TC003_SearchEmployeeTest"/>
               <class name="testCases.TC004_EditEmployeeTest"/>
                 <class name="testCases.TC005_LogoutTest"/>
           
           
           
        </classes>

    </test>
    
    <test name="Firefox Test">
    
     <parameter name="browser" value="firefox"/>

        <classes>
          
            <class name="testCases.TC001_LoginTest"/>
            <class name="testCases.TC002_AddEmployeeTest"/>
             <class name="testCases.TC003_SearchEmployeeTest"/>
               <class name="testCases.TC004_EditEmployeeTest"/>
                 <class name="testCases.TC005_LogoutTest"/>
           
           
           
        </classes>

    </test>

</suite>